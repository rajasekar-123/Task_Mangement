# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public
PORT=4000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of browser origins allowed for CORS + Socket.io
CORS_ORIGINS=http://localhost:5173
# lax | strict | none  (none requires HTTPS)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Cron expression for the overdue sweep (default: every minute)
OVERDUE_CRON=* * * * *
